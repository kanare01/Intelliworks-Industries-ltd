# Intelliworks Industries Configuration

# Supabase Credentials (from Supabase Project Settings -> API)
# Required for server-side persistence, auth verification, and protected storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend Supabase configuration (injected to Vite client)
# Note: NEVER expose SUPABASE_SERVICE_ROLE_KEY to VITE_
VITE_SUPABASE_URL=https://fbgusiecnvmzmmfkpiac.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IcMKSNwesFiptcQ7BKrDww_QSZ6108u
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Flask Backend Security
FLASK_SECRET_KEY=generate-a-strong-random-secret-key-32-chars
APP_ENV=development
FLASK_PORT=5001

# Application URLs
APP_URL="MY_APP_URL"
FRONTEND_URL=http://localhost:3000

# Platform Capability
GEMINI_API_KEY="MY_GEMINI_API_KEY"
